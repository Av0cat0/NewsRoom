# Copy to .env and fill in. Gmail: enable 2FA, then create an App Password (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=NewsRoom
MAIL_TO=you@gmail.com
# TASE Data Hub API key (store.tase.co.il -> your subscription)
TASE_API_KEY=
